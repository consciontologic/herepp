{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "needs_clarification",
        "unsupported"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "app": {
      "anyOf": [
        {
          "$ref": "#/$defs/app"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "message",
    "questions",
    "app"
  ],
  "$defs": {
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "field",
            "constant",
            "add",
            "subtract",
            "multiply",
            "divide"
          ]
        },
        "field_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "op",
        "field_id",
        "value"
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "minLength": 1,
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "boolean",
            "date"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        }
      },
      "required": [
        "id",
        "label",
        "type",
        "required",
        "unit"
      ]
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "minLength": 1,
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "program": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/instruction"
          }
        }
      },
      "required": [
        "id",
        "label",
        "unit",
        "program"
      ]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "kind": {
          "type": "string",
          "enum": [
            "logger",
            "checklist",
            "calculator"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "calculations": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/calculation"
          }
        },
        "summary_field_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "accent": {
          "type": "string",
          "enum": [
            "blue",
            "green",
            "orange",
            "purple",
            "slate"
          ]
        },
        "empty_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        }
      },
      "required": [
        "spec_version",
        "title",
        "description",
        "kind",
        "fields",
        "calculations",
        "summary_field_id",
        "accent",
        "empty_state"
      ]
    }
  }
}
